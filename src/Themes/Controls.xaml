<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:v="clr-namespace:MovieMakerReborn.Views">

    <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <!-- ===================== Ribbon buttons ===================== -->
    <Style TargetType="{x:Type v:RibbonButton}">
        <Setter Property="Foreground" Value="{DynamicResource B.Text}"/>
        <Setter Property="GlyphBrush" Value="{DynamicResource B.Glyph}"/>
        <Setter Property="BadgeBrush" Value="{DynamicResource B.GlyphGreen}"/>
        <Setter Property="FontSize" Value="11.5"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Margin" Value="1"/>
        <Setter Property="Cursor" Value="Arrow"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type v:RibbonButton}">
                    <Border x:Name="Bd" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="3" Padding="4,1,6,1">
                        <StackPanel x:Name="Sp" Orientation="Horizontal" VerticalAlignment="Center">
                            <Grid x:Name="IconGrid" Width="16" Height="16" VerticalAlignment="Center">
                                <TextBlock x:Name="Gl" Text="{TemplateBinding Glyph}" FontFamily="{StaticResource IconFont}" FontSize="15"
                                           Foreground="{TemplateBinding GlyphBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <Path x:Name="GP" Data="{TemplateBinding GlyphPath}" Stroke="{TemplateBinding GlyphBrush}" StrokeThickness="1.4" Stretch="Uniform" Margin="1"
                                      StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" SnapsToDevicePixels="True"/>
                                <TextBlock x:Name="Bg" Text="{TemplateBinding Badge}" FontFamily="{StaticResource IconFont}" FontSize="9" FontWeight="Bold"
                                           Foreground="{TemplateBinding BadgeBrush}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-3,-2"/>
                            </Grid>
                            <TextBlock x:Name="Lb" Text="{TemplateBinding Label}" Margin="5,0,0,0" VerticalAlignment="Center" TextAlignment="Center"
                                       Foreground="{TemplateBinding Foreground}"/>
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsLarge" Value="True">
                            <Setter TargetName="Sp" Property="Orientation" Value="Vertical"/>
                            <Setter TargetName="IconGrid" Property="Width" Value="32"/>
                            <Setter TargetName="IconGrid" Property="Height" Value="32"/>
                            <Setter TargetName="IconGrid" Property="HorizontalAlignment" Value="Center"/>
                            <Setter TargetName="Gl" Property="FontSize" Value="26"/>
                            <Setter TargetName="GP" Property="StrokeThickness" Value="1.8"/>
                            <Setter TargetName="GP" Property="Margin" Value="3"/>
                            <Setter TargetName="Bg" Property="FontSize" Value="13"/>
                            <Setter TargetName="Lb" Property="Margin" Value="0,3,0,0"/>
                            <Setter TargetName="Lb" Property="TextWrapping" Value="Wrap"/>
                            <Setter TargetName="Lb" Property="MaxWidth" Value="72"/>
                            <Setter TargetName="Lb" Property="LineHeight" Value="13"/>
                            <Setter TargetName="Bd" Property="Padding" Value="4,3,4,2"/>
                            <Setter TargetName="Sp" Property="VerticalAlignment" Value="Top"/>
                            <Setter Property="VerticalAlignment" Value="Stretch"/>
                            <Setter Property="MinWidth" Value="46"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource B.Hover}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource B.HoverBorder}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource B.Pressed}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.38"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type v:RibbonToggle}">
        <Setter Property="Foreground" Value="{DynamicResource B.Text}"/>
        <Setter Property="GlyphBrush" Value="{DynamicResource B.Glyph}"/>
        <Setter Property="FontSize" Value="11.5"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Margin" Value="1"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type v:RibbonToggle}">
                    <Border x:Name="Bd" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="3" Padding="4,1,6,1">
                        <StackPanel x:Name="Sp" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="Gl" Text="{TemplateBinding Glyph}" FontFamily="{StaticResource IconFont}" FontSize="14" Width="16"
                                       TextAlignment="Center" Foreground="{TemplateBinding GlyphBrush}" VerticalAlignment="Center"/>
                            <TextBlock x:Name="Lb" Text="{TemplateBinding Label}" Margin="5,0,0,0" VerticalAlignment="Center" Foreground="{TemplateBinding Foreground}"/>
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Label" Value="{x:Null}">
                            <Setter TargetName="Lb" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="Bd" Property="Padding" Value="3,1"/>
                        </Trigger>
                        <Trigger Property="IsLarge" Value="True">
                            <Setter TargetName="Sp" Property="Orientation" Value="Vertical"/>
                            <Setter TargetName="Gl" Property="FontSize" Value="24"/>
                            <Setter TargetName="Gl" Property="Width" Value="32"/>
                            <Setter TargetName="Gl" Property="Height" Value="32"/>
                            <Setter TargetName="Lb" Property="Margin" Value="0,3,0,0"/>
                            <Setter TargetName="Lb" Property="TextWrapping" Value="Wrap"/>
                            <Setter TargetName="Lb" Property="MaxWidth" Value="72"/>
                            <Setter TargetName="Lb" Property="TextAlignment" Value="Center"/>
                            <Setter TargetName="Sp" Property="VerticalAlignment" Value="Top"/>
                            <Setter TargetName="Bd" Property="Padding" Value="4,3,4,2"/>
                            <Setter Property="VerticalAlignment" Value="Stretch"/>
                            <Setter Property="MinWidth" Value="46"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource B.Hover}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource B.HoverBorder}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource B.Checked}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource B.Accent}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.38"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Ribbon group: content on top, label at bottom, separator on the right -->
    <Style x:Key="RibbonGroup" TargetType="HeaderedContentControl">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="HeaderedContentControl">
                    <Border BorderBrush="{DynamicResource B.GroupSep}" BorderThickness="0,0,1,0" Padding="5,3,6,1" Margin="0,2,0,2">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Bottom" Text="{TemplateBinding Header}" Foreground="{DynamicResource B.Dim}" FontSize="10.5" FontFamily="{DynamicResource F.Display}"
                                       HorizontalAlignment="Center" Margin="0,1,0,0"/>
                            <ContentPresenter/>
                        </DockPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Ribbon tab headers -->
    <Style x:Key="TabHeader" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource B.Dim}"/>
        <Setter Property="FontFamily" Value="{DynamicResource F.Display}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Padding" Value="12,5,12,4"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Bd" Background="Transparent" BorderBrush="Transparent" BorderThickness="0,0,0,2" Padding="{TemplateBinding Padding}" Margin="2,0,2,0">
                        <ContentPresenter HorizontalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource B.Text}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource B.Text}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource B.Accent}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="FileTab" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource B.AccentText}"/>
        <Setter Property="Background" Value="{DynamicResource B.FileTab}"/>
        <Setter Property="FontFamily" Value="{DynamicResource F.Display}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="2" Padding="14,3,14,3" Margin="6,0,8,3">
                        <ContentPresenter HorizontalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Title bar buttons -->
    <Style x:Key="CaptionButton" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource B.Text}"/>
        <Setter Property="FontFamily" Value="{StaticResource IconFont}"/>
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="Width" Value="46"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="Transparent">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource B.Hover}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="CloseButton" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="Transparent">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#E81123"/>
                            <Setter Property="Foreground" Value="{DynamicResource B.AccentText}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="QatButton" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource B.Glyph}"/>
        <Setter Property="FontFamily" Value="{StaticResource IconFont}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Width" Value="26"/>
        <Setter Property="Height" Value="24"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="3">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource B.Hover}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.35"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Transport buttons under the preview -->
    <Style x:Key="TransportButton" TargetType="Button" BasedOn="{StaticResource QatButton}">
        <Setter Property="Width" Value="34"/>
        <Setter Property="Height" Value="30"/>
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="Foreground" Value="{DynamicResource B.Text}"/>
    </Style>

    <Style x:Key="SwatchButton" TargetType="Button">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{DynamicResource B.Border}" BorderThickness="1" CornerRadius="2"/>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource B.Accent}"/>
                            <Setter TargetName="Bd" Property="BorderThickness" Value="2"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type v:ColorButton}">
        <Setter Property="Foreground" Value="{DynamicResource B.Text}"/>
        <Setter Property="FontSize" Value="11.5"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Margin" Value="1"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type v:ColorButton}">
                    <Border x:Name="Bd" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="3" Padding="4,1,6,1">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="16" Height="14" Background="{TemplateBinding Swatch}" BorderBrush="{DynamicResource B.Border}" BorderThickness="1" CornerRadius="2" VerticalAlignment="Center"/>
                            <TextBlock Text="{TemplateBinding Label}" Margin="5,0,0,0" VerticalAlignment="Center"/>
                            <TextBlock Text="&#xE70D;" FontFamily="{StaticResource IconFont}" FontSize="8" Margin="4,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource B.Dim}"/>
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource B.Hover}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource B.HoverBorder}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.38"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Gallery -->
    <Style x:Key="GalleryItem" TargetType="ToggleButton">
        <Setter Property="Foreground" Value="{DynamicResource B.Text}"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Margin" Value="1"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Bd" Background="Transparent" BorderBrush="Transparent" BorderThickness="1.5" CornerRadius="3" Padding="4,4,4,2">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource B.Hover}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource B.HoverBorder}"/>
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource B.Checked}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="GalleryArrow" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource B.Dim}"/>
        <Setter Property="FontFamily" Value="{StaticResource IconFont}"/>
        <Setter Property="FontSize" Value="9"/>
        <Setter Property="Width" Value="16"/>
        <Setter Property="Height" Value="21"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="Transparent" BorderBrush="{DynamicResource B.Border}" BorderThickness="1" CornerRadius="2" Margin="0,0,0,1">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource B.Hover}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== Standard controls ===================== -->
    <Style TargetType="TextBlock">
        <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
    </Style>

    <Style TargetType="ToolTip">
        <Setter Property="Foreground" Value="{DynamicResource B.Text}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="{DynamicResource B.Menu}" BorderBrush="{DynamicResource B.Border}" BorderThickness="1" CornerRadius="3" Padding="8,4" MaxWidth="320">
                        <ContentPresenter TextElement.Foreground="{DynamicResource B.Text}" TextElement.FontSize="12">
                            <ContentPresenter.Resources>
                                <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
                            </ContentPresenter.Resources>
                        </ContentPresenter>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource B.Text}"/>
        <Setter Property="Background" Value="{DynamicResource B.Hover}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource B.Border}"/>
        <Setter Property="Padding" Value="16,5"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource B.Pressed}"/>
                        </Trigger>
                        <Trigger Property="IsDefault" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource B.Accent}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource B.Accent}"/>
                            <Setter Property="Foreground" Value="{DynamicResource B.AccentText}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="TextBox">
        <Setter Property="Foreground" Value="{DynamicResource B.Text}"/>
        <Setter Property="Background" Value="{DynamicResource B.Input}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource B.InputBorder}"/>
        <Setter Property="CaretBrush" Value="{DynamicResource B.Text}"/>
        <Setter Property="SelectionBrush" Value="{DynamicResource B.Accent}"/>
        <Setter Property="Padding" Value="3,1"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="2">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource B.Accent}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource B.Text}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Border x:Name="Box" Width="15" Height="15" Background="{DynamicResource B.Input}" BorderBrush="{DynamicResource B.InputBorder}" BorderThickness="1" CornerRadius="3" VerticalAlignment="Center">
                            <TextBlock x:Name="Check" Text="&#xE73E;" FontFamily="{StaticResource IconFont}" FontSize="10" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                        </Border>
                        <ContentPresenter Margin="6,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Check" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource B.Accent}"/>
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource B.Accent}"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource B.Accent}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource B.Text}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Grid Width="15" Height="15" VerticalAlignment="Center">
                            <Ellipse x:Name="Ring" Fill="{DynamicResource B.Input}" Stroke="{DynamicResource B.InputBorder}" StrokeThickness="1"/>
                            <Ellipse x:Name="Dot" Width="7" Height="7" Fill="{DynamicResource B.Accent}" Visibility="Collapsed"/>
                        </Grid>
                        <ContentPresenter Margin="6,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Dot" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource B.Accent}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ComboBox -->
    <Style x:Key="ComboToggle" TargetType="ToggleButton">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Bd" Background="{DynamicResource B.Input}" BorderBrush="{DynamicResource B.InputBorder}" BorderThickness="1" CornerRadius="2">
                        <TextBlock Text="&#xE70D;" FontFamily="{StaticResource IconFont}" FontSize="8" Foreground="{DynamicResource B.Dim}"
                                   HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource B.Accent}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ComboBox">
        <Setter Property="Foreground" Value="{DynamicResource B.Text}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Height" Value="22"/>
        <Setter Property="MaxDropDownHeight" Value="360"/>
        <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate><VirtualizingStackPanel/></ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton x:Name="Toggle" Style="{StaticResource ComboToggle}" ClickMode="Press"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"/>
                        <ContentPresenter x:Name="Content" IsHitTestVisible="False" Margin="6,0,20,0" VerticalAlignment="Center"
                                          Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          TextElement.Foreground="{TemplateBinding Foreground}"/>
                        <TextBox x:Name="PART_EditableTextBox" Visibility="Collapsed" Margin="1,1,18,1" Padding="3,0" Background="Transparent"
                                 BorderThickness="0" BorderBrush="Transparent" VerticalContentAlignment="Center" IsReadOnly="{TemplateBinding IsReadOnly}"/>
                        <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False" PopupAnimation="None">
                            <Border Background="{DynamicResource B.Menu}" BorderBrush="{DynamicResource B.Border}" BorderThickness="1" CornerRadius="3"
                                    MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="{TemplateBinding MaxDropDownHeight}" Padding="2">
                                <ScrollViewer>
                                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEditable" Value="True">
                            <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="Content" Property="Visibility" Value="Hidden"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource B.Text}"/>
        <Setter Property="Padding" Value="8,3"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="2" Padding="{TemplateBinding Padding}">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource B.Checked}"/>
                        </Trigger>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource B.Hover}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Slider -->
    <Style x:Key="SliderRepeat" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Grid Background="Transparent">
                        <Border Height="3" CornerRadius="1.5" Background="{TemplateBinding Background}" VerticalAlignment="Center"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="SliderThumb" TargetType="Thumb">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Ellipse x:Name="E" Width="13" Height="13" Fill="{DynamicResource B.Accent}" Stroke="{DynamicResource B.Ribbon}" StrokeThickness="2"/>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="E" Property="Width" Value="15"/>
                            <Setter TargetName="E" Property="Height" Value="15"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="Slider">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="MinHeight" Value="18"/>
        <Setter Property="IsMoveToPointEnabled" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid VerticalAlignment="Center" Background="Transparent">
                        <Border Height="3" CornerRadius="1.5" Background="{DynamicResource B.InputBorder}" VerticalAlignment="Center"/>
                        <Track x:Name="PART_Track">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="Slider.DecreaseLarge" Style="{StaticResource SliderRepeat}" Background="{DynamicResource B.Accent}"/>
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="Slider.IncreaseLarge" Style="{StaticResource SliderRepeat}" Background="Transparent"/>
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource SliderThumb}"/>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ScrollBar -->
    <Style x:Key="ScrollRepeat" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="ScrollThumb" TargetType="Thumb">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="B" CornerRadius="4" Background="{DynamicResource B.Thumb}" Margin="2"/>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="B" Property="Background" Value="{DynamicResource B.Dim}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="11"/>
        <Setter Property="MinWidth" Value="11"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="Transparent">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand" Style="{StaticResource ScrollRepeat}"/></Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand" Style="{StaticResource ScrollRepeat}"/></Track.IncreaseRepeatButton>
                            <Track.Thumb><Thumb Style="{StaticResource ScrollThumb}"/></Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto"/>
                <Setter Property="MinWidth" Value="0"/>
                <Setter Property="Height" Value="11"/>
                <Setter Property="MinHeight" Value="11"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Grid Background="Transparent">
                                <Track x:Name="PART_Track" IsDirectionReversed="False">
                                    <Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageLeftCommand" Style="{StaticResource ScrollRepeat}"/></Track.DecreaseRepeatButton>
                                    <Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageRightCommand" Style="{StaticResource ScrollRepeat}"/></Track.IncreaseRepeatButton>
                                    <Track.Thumb><Thumb Style="{StaticResource ScrollThumb}"/></Track.Thumb>
                                </Track>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Context menu -->
    <Style TargetType="ContextMenu">
        <Setter Property="Foreground" Value="{DynamicResource B.Text}"/>
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Border Background="{DynamicResource B.Menu}" BorderBrush="{DynamicResource B.Border}" BorderThickness="1" CornerRadius="4" Padding="3" MinWidth="200">
                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="MenuItem">
        <Setter Property="Foreground" Value="{DynamicResource B.Text}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="3" Padding="6,4,10,4">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="26"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ContentPresenter ContentSource="Icon" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                            <ContentPresenter Grid.Column="1" ContentSource="Header" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                            <TextBlock Grid.Column="2" Text="{TemplateBinding InputGestureText}" Foreground="{DynamicResource B.Dim}" Margin="24,0,0,0" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource B.Hover}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="Separator">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator">
                    <Border Height="1" Background="{DynamicResource B.Border}" Margin="6,3"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- File menu entries -->
    <Style x:Key="FileMenuButton" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource B.Text}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="3" Padding="10,8">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource B.Hover}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Dialog window look -->
    <Style x:Key="DialogWindow" TargetType="Window">
        <Setter Property="Background" Value="{DynamicResource B.Panel}"/>
        <Setter Property="Foreground" Value="{DynamicResource B.Text}"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="ShowInTaskbar" Value="False"/>
        <Setter Property="ResizeMode" Value="NoResize"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
    </Style>

    <Style TargetType="ProgressBar">
        <Setter Property="Foreground" Value="{DynamicResource B.Accent}"/>
        <Setter Property="Background" Value="{DynamicResource B.Input}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Border x:Name="PART_Track" Background="{TemplateBinding Background}" CornerRadius="4" BorderBrush="{DynamicResource B.Border}" BorderThickness="1" ClipToBounds="True">
                        <Grid>
                            <Border x:Name="PART_Indicator" HorizontalAlignment="Left" Background="{TemplateBinding Foreground}" CornerRadius="4"/>
                            <Border x:Name="Indeterminate" Background="{TemplateBinding Foreground}" Opacity="0.5" Visibility="Collapsed" CornerRadius="4"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsIndeterminate" Value="True">
                            <Setter TargetName="Indeterminate" Property="Visibility" Value="Visible"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ListBox">
        <Setter Property="Background" Value="{DynamicResource B.Input}"/>
        <Setter Property="Foreground" Value="{DynamicResource B.Text}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource B.Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBox">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="3">
                        <ScrollViewer Focusable="False"><ItemsPresenter/></ScrollViewer>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="ListBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource B.Text}"/>
        <Setter Property="Padding" Value="10,7"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="3" Padding="{TemplateBinding Padding}" Margin="0,1">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource B.Hover}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource B.Checked}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Label" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource B.Dim}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="FontSize" Value="11.5"/>
    </Style>
</ResourceDictionary>
