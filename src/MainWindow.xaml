<Window x:Class="MovieMakerReborn.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:MovieMakerReborn.Views"
        Title="Gerbera Studio" Width="1360" Height="860" MinWidth="980" MinHeight="620"
        Background="{DynamicResource B.Window}" Foreground="{DynamicResource B.Text}"
        FontFamily="Segoe UI" FontSize="12" UseLayoutRounding="True" WindowStartupLocation="CenterScreen"
        Icon="pack://application:,,,/app.ico">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="32" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Border x:Name="RootBorder" BorderBrush="{DynamicResource B.Border}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="32"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="26"/>
            </Grid.RowDefinitions>

            <!-- ============ Title bar with quick access toolbar ============ -->
            <Grid Grid.Row="0" Background="{DynamicResource B.Title}">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                    <Image Source="pack://application:,,,/app.ico" Width="18" Height="18" Margin="0,0,8,0"/>
                    <Button Style="{StaticResource QatButton}" Content="&#xE74E;" ToolTip="Save project (Ctrl+S)" Tag="save" Click="Cmd" WindowChrome.IsHitTestVisibleInChrome="True"/>
                    <Button x:Name="QatUndo" Style="{StaticResource QatButton}" Content="&#xE7A7;" ToolTip="Undo (Ctrl+Z)" Tag="undo" Click="Cmd" WindowChrome.IsHitTestVisibleInChrome="True"/>
                    <Button x:Name="QatRedo" Style="{StaticResource QatButton}" Content="&#xE7A6;" ToolTip="Redo (Ctrl+Y)" Tag="redo" Click="Cmd" WindowChrome.IsHitTestVisibleInChrome="True"/>
                    <Border Width="1" Height="16" Background="{DynamicResource B.Border}" Margin="5,0"/>
                    <Button Style="{StaticResource QatButton}" Content="&#xE896;" ToolTip="Export movie (Ctrl+E)" Tag="savemovie" Click="Cmd" WindowChrome.IsHitTestVisibleInChrome="True"/>
                </StackPanel>
                <TextBlock x:Name="TitleText" Text="My Movie - Gerbera Studio" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource B.Dim}" FontSize="12" FontFamily="{DynamicResource F.Display}"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="ThemeToggle" Style="{StaticResource CaptionButton}" FontSize="13" Content="&#xE708;" ToolTip="Theme" Tag="themetoggle" Click="Cmd" WindowChrome.IsHitTestVisibleInChrome="True"/>
                    <Button Style="{StaticResource CaptionButton}" Content="&#xE921;" Click="MinClick" WindowChrome.IsHitTestVisibleInChrome="True"/>
                    <Button x:Name="MaxButton" Style="{StaticResource CaptionButton}" Content="&#xE922;" Click="MaxClick" WindowChrome.IsHitTestVisibleInChrome="True"/>
                    <Button Style="{StaticResource CloseButton}" Content="&#xE8BB;" Click="CloseClick" WindowChrome.IsHitTestVisibleInChrome="True"/>
                </StackPanel>
            </Grid>

            <!-- ============ Ribbon tabs ============ -->
            <Grid Grid.Row="1" Background="{DynamicResource B.Tabs}">
                <StackPanel Orientation="Horizontal" Margin="0,3,0,0" VerticalAlignment="Bottom">
                    <Button x:Name="FileTabButton" Style="{StaticResource FileTab}" Content="FILE" Click="FileTabClick"/>
                    <RadioButton x:Name="TabHome" Style="{StaticResource TabHeader}" Content="HOME" GroupName="tabs" IsChecked="True" Checked="TabChecked"/>
                    <RadioButton x:Name="TabAnim" Style="{StaticResource TabHeader}" Content="ANIMATIONS" GroupName="tabs" Checked="TabChecked"/>
                    <RadioButton x:Name="TabFx" Style="{StaticResource TabHeader}" Content="VISUAL EFFECTS" GroupName="tabs" Checked="TabChecked"/>
                    <RadioButton x:Name="TabProject" Style="{StaticResource TabHeader}" Content="PROJECT" GroupName="tabs" Checked="TabChecked"/>
                    <RadioButton x:Name="TabView" Style="{StaticResource TabHeader}" Content="VIEW" GroupName="tabs" Checked="TabChecked"/>
                    <Border x:Name="CtxVideo" BorderBrush="{DynamicResource B.CtxVideo}" BorderThickness="0,3,0,0" Margin="6,0,0,0" Visibility="Collapsed">
                        <RadioButton x:Name="TabVideo" Style="{StaticResource TabHeader}" GroupName="tabs" Checked="TabChecked" ToolTip="Video Tools">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="CtxVideoLabel" Text="VIDEO TOOLS" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource B.CtxVideo}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="EDIT"/>
                            </StackPanel>
                        </RadioButton>
                    </Border>
                    <Border x:Name="CtxMusic" BorderBrush="{DynamicResource B.CtxMusic}" BorderThickness="0,3,0,0" Margin="6,0,0,0" Visibility="Collapsed">
                        <RadioButton x:Name="TabMusic" Style="{StaticResource TabHeader}" GroupName="tabs" Checked="TabChecked" ToolTip="Music Tools">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="MUSIC TOOLS" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource B.CtxMusic}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="OPTIONS"/>
                            </StackPanel>
                        </RadioButton>
                    </Border>
                    <Border x:Name="CtxText" BorderBrush="{DynamicResource B.CtxText}" BorderThickness="0,3,0,0" Margin="6,0,0,0" Visibility="Collapsed">
                        <RadioButton x:Name="TabText" Style="{StaticResource TabHeader}" GroupName="tabs" Checked="TabChecked" ToolTip="Text Tools">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="TEXT TOOLS" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource B.CtxText}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="FORMAT"/>
                            </StackPanel>
                        </RadioButton>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- ============ Ribbon body ============ -->
            <Border Grid.Row="2" Background="{DynamicResource B.Ribbon}" BorderBrush="{DynamicResource B.Border}" BorderThickness="0,1,0,1" Height="98">
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" PreviewMouseWheel="RibbonWheel">
                <Grid Margin="2,0">

                    <!-- HOME -->
                    <StackPanel x:Name="PanelHome" Orientation="Horizontal">
                        <HeaderedContentControl Header="Clipboard" Style="{StaticResource RibbonGroup}">
                            <StackPanel Orientation="Horizontal">
                                <v:RibbonButton IsLarge="True" Glyph="&#xE77F;" Label="Paste" Tag="paste" Click="Cmd" ToolTip="Paste (Ctrl+V)"/>
                                <StackPanel>
                                    <v:RibbonButton Glyph="&#xE8C6;" Label="Cut" Tag="cut" Click="Cmd" ToolTip="Cut (Ctrl+X)"/>
                                    <v:RibbonButton Glyph="&#xE8C8;" Label="Copy" Tag="copy" Click="Cmd" ToolTip="Copy (Ctrl+C)"/>
                                </StackPanel>
                            </StackPanel>
                        </HeaderedContentControl>
                        <HeaderedContentControl Header="Add" Style="{StaticResource RibbonGroup}">
                            <StackPanel Orientation="Horizontal">
                                <v:RibbonButton IsLarge="True" Glyph="&#xE714;" Badge="&#xE710;" GlyphBrush="{DynamicResource B.GlyphBlue}" Label="Add videos and photos" Tag="addmedia" Click="Cmd" ToolTip="Add videos and photos (Ctrl+I)"/>
                                <v:RibbonButton IsLarge="True" Glyph="&#xE8D6;" Badge="&#xE710;" GlyphBrush="{DynamicResource B.GlyphGreen}" Label="Add music" Tag="addmusic" Click="Cmd" ToolTip="Add music at the start of the project"/>
                                <StackPanel>
                                    <v:RibbonButton Glyph="&#xE8D6;" GlyphBrush="{DynamicResource B.GlyphGreen}" Label="Music at current point" Tag="addmusicat" Click="Cmd" ToolTip="Add music starting at the playhead"/>
                                    <v:RibbonButton Glyph="&#xE722;" GlyphBrush="{DynamicResource B.GlyphOrange}" Label="Snapshot" Tag="snapshot" Click="Cmd" ToolTip="Save the current frame as a photo and add it to the storyboard"/>
                                </StackPanel>
                                <StackPanel Margin="4,0,0,0">
                                    <v:RibbonButton Glyph="&#xE8D2;" GlyphBrush="{DynamicResource B.GlyphPurple}" Label="Title" Tag="title" Click="Cmd" ToolTip="Add a title before the selected item"/>
                                    <v:RibbonButton Glyph="&#xE70F;" GlyphBrush="{DynamicResource B.GlyphPurple}" Label="Caption" Tag="caption" Click="Cmd" ToolTip="Add a caption at the playhead"/>
                                    <v:RibbonButton Glyph="&#xE8FD;" GlyphBrush="{DynamicResource B.GlyphPurple}" Label="Credits" Tag="credits" Click="Cmd" ToolTip="Add scrolling credits at the end"/>
                                </StackPanel>
                            </StackPanel>
                        </HeaderedContentControl>
                        <HeaderedContentControl Header="Editing" Style="{StaticResource RibbonGroup}">
                            <StackPanel Orientation="Horizontal">
                                <v:RibbonButton IsLarge="True" Glyph="&#xE7A7;" Label="Rotate left" Tag="rotl" Click="Cmd"/>
                                <v:RibbonButton IsLarge="True" Glyph="&#xE7A6;" Label="Rotate right" Tag="rotr" Click="Cmd"/>
                                <StackPanel>
                                    <v:RibbonButton Glyph="&#xE74D;" GlyphBrush="{DynamicResource B.GlyphRed}" Label="Remove" Tag="remove" Click="Cmd" ToolTip="Remove (Delete)"/>
                                    <v:RibbonButton Glyph="&#xE8B3;" Label="Select all" Tag="selectall" Click="Cmd" ToolTip="Select all (Ctrl+A)"/>
                                    <v:RibbonButton GlyphPath="M1,3.5 L6,3.5 L6,12.5 L1,12.5 Z M10,3.5 L15,3.5 L15,12.5 L10,12.5 Z M8,1 L8,15" Label="Split" Tag="split" Click="Cmd" ToolTip="Split at the playhead (M)"/>
                                </StackPanel>
                            </StackPanel>
                        </HeaderedContentControl>
                        <HeaderedContentControl Header="Export" Style="{StaticResource RibbonGroup}">
                            <StackPanel Orientation="Horizontal">
                                <v:RibbonButton IsLarge="True" Glyph="&#xE714;" Badge="&#xE896;" BadgeBrush="{DynamicResource B.GlyphBlue}" GlyphBrush="{DynamicResource B.GlyphBlue}" Label="Export movie" Tag="savemovie" Click="Cmd" ToolTip="Export your movie as a video file (Ctrl+E)"/>
                                <StackPanel>
                                    <v:RibbonButton Glyph="&#xE7F4;" Label="4K Ultra HD" Tag="quick4k" Click="Cmd" ToolTip="Export in 4K (2160p) with recommended settings"/>
                                    <v:RibbonButton Glyph="&#xE7F4;" Label="1080p HD" Tag="quick1080" Click="Cmd" ToolTip="Export in 1080p with recommended settings"/>
                                    <v:RibbonButton Glyph="&#xE8EA;" Label="Vertical (Shorts)" Tag="quickvert" Click="Cmd" ToolTip="Export a 1080×1920 vertical video"/>
                                </StackPanel>
                            </StackPanel>
                        </HeaderedContentControl>
                    </StackPanel>

                    <!-- ANIMATIONS -->
                    <StackPanel x:Name="PanelAnim" Orientation="Horizontal" Visibility="Collapsed">
                        <HeaderedContentControl Header="Transitions" Style="{StaticResource RibbonGroup}">
                            <StackPanel Orientation="Horizontal">
                                <v:Gallery x:Name="TransGallery" Width="560" Height="74" ItemWidth="74"/>
                                <StackPanel Margin="6,0,0,0" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <TextBlock Text="Duration:" Style="{StaticResource Label}" Margin="2,0,6,0"/>
                                        <ComboBox x:Name="TransDurCombo" Width="70" IsEditable="True" SelectionChanged="TransDurChanged" LostFocus="TransDurCommit" KeyDown="ComboEnter"/>
                                    </StackPanel>
                                    <v:RibbonButton Glyph="&#xE8B3;" Label="Apply to all" Tag="trans_all" Click="Cmd"/>
                                </StackPanel>
                            </StackPanel>
                        </HeaderedContentControl>
                        <HeaderedContentControl Header="Pan and zoom" Style="{StaticResource RibbonGroup}">
                            <StackPanel Orientation="Horizontal">
                                <v:Gallery x:Name="PanGallery" Width="330" Height="74" ItemWidth="66"/>
                                <StackPanel Margin="6,0,0,0" VerticalAlignment="Center">
                                    <v:RibbonButton Glyph="&#xE8B3;" Label="Apply to all" Tag="pan_all" Click="Cmd"/>
                                </StackPanel>
                            </StackPanel>
                        </HeaderedContentControl>
                    </StackPanel>

                    <!-- VISUAL EFFECTS -->
                    <StackPanel x:Name="PanelFx" Orientation="Horizontal" Visibility="Collapsed">
                        <HeaderedContentControl Header="Effects" Style="{StaticResource RibbonGroup}">
                            <StackPanel Orientation="Horizontal">
                                <v:Gallery x:Name="FxGallery" Width="470" Height="74" ItemWidth="74"/>
                                <StackPanel Margin="6,0,0,0" VerticalAlignment="Center">
                                    <v:RibbonButton Glyph="&#xE8B3;" Label="Apply to all" Tag="fx_all" Click="Cmd"/>
                                </StackPanel>
                            </StackPanel>
                        </HeaderedContentControl>
                        <HeaderedContentControl Header="Adjust" Style="{StaticResource RibbonGroup}">
                            <Grid Width="250" VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="22"/>
                                    <RowDefinition Height="22"/>
                                    <RowDefinition Height="22"/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="Brightness" Style="{StaticResource Label}"/>
                                <Slider x:Name="BrightSlider" Grid.Column="1" Minimum="-1" Maximum="1" Margin="8,0" ValueChanged="AdjustChanged" PreviewMouseUp="SliderCommit" LostMouseCapture="SliderCommit"/>
                                <TextBlock Grid.Row="1" Text="Contrast" Style="{StaticResource Label}"/>
                                <Slider x:Name="ContrastSlider" Grid.Row="1" Grid.Column="1" Minimum="-1" Maximum="1" Margin="8,0" ValueChanged="AdjustChanged" PreviewMouseUp="SliderCommit" LostMouseCapture="SliderCommit"/>
                                <TextBlock Grid.Row="2" Text="Saturation" Style="{StaticResource Label}"/>
                                <Slider x:Name="SatSlider" Grid.Row="2" Grid.Column="1" Minimum="-1" Maximum="1" Margin="8,0" ValueChanged="AdjustChanged" PreviewMouseUp="SliderCommit" LostMouseCapture="SliderCommit"/>
                                <v:RibbonButton Grid.Column="2" Grid.RowSpan="3" IsLarge="True" Glyph="&#xE72C;" Label="Reset" Tag="fx_reset" Click="Cmd"/>
                            </Grid>
                        </HeaderedContentControl>
                        <HeaderedContentControl Header="Green screen" Style="{StaticResource RibbonGroup}">
                            <StackPanel Orientation="Horizontal">
                                <v:RibbonToggle x:Name="KeyToggle" IsLarge="True" Glyph="&#xE81E;" Label="Remove background color" Click="KeyToggleClick" ToolTip="Make the key color (usually green) transparent and show a background behind it"/>
                                <StackPanel VerticalAlignment="Center" Width="190" Margin="4,0">
                                    <StackPanel Orientation="Horizontal">
                                        <v:ColorButton x:Name="KeyColorBtn" Label="Key"/>
                                        <v:RibbonButton Glyph="&#xE790;" GlyphBrush="#3BD16F" Label="Green" Tag="key_green" Click="Cmd"/>
                                        <v:RibbonButton Glyph="&#xE790;" GlyphBrush="#3B8BFF" Label="Blue" Tag="key_blue" Click="Cmd"/>
                                    </StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="62"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions><RowDefinition Height="20"/><RowDefinition Height="20"/></Grid.RowDefinitions>
                                        <TextBlock Text="Tolerance" Style="{StaticResource Label}"/>
                                        <Slider x:Name="KeyTolSlider" Grid.Column="1" Minimum="0.02" Maximum="0.5" ValueChanged="KeySliderChanged" PreviewMouseUp="SliderCommit" LostMouseCapture="SliderCommit"/>
                                        <TextBlock Grid.Row="1" Text="Softness" Style="{StaticResource Label}"/>
                                        <Slider x:Name="KeySoftSlider" Grid.Row="1" Grid.Column="1" Minimum="0.01" Maximum="0.4" ValueChanged="KeySliderChanged" PreviewMouseUp="SliderCommit" LostMouseCapture="SliderCommit"/>
                                    </Grid>
                                </StackPanel>
                                <StackPanel VerticalAlignment="Center">
                                    <v:RibbonButton Glyph="&#xE8B9;" Label="Background…" Tag="key_bg" Click="Cmd" ToolTip="Choose a photo or video to show behind the subject"/>
                                    <v:ColorButton x:Name="KeyBgColorBtn" Label="Background color"/>
                                    <CheckBox x:Name="KeySpillCheck" Content="Remove color spill" Margin="4,3,0,0" Click="KeySpillClick"/>
                                </StackPanel>
                            </StackPanel>
                        </HeaderedContentControl>
                    </StackPanel>

                    <!-- PROJECT -->
                    <StackPanel x:Name="PanelProject" Orientation="Horizontal" Visibility="Collapsed">
                        <HeaderedContentControl Header="Audio" Style="{StaticResource RibbonGroup}">
                            <StackPanel Orientation="Horizontal">
                                <StackPanel Width="170" VerticalAlignment="Center">
                                    <TextBlock Text="Audio mix" Style="{StaticResource Label}" HorizontalAlignment="Center"/>
                                    <Slider x:Name="MixSlider" Minimum="-1" Maximum="1" Margin="4,2" ValueChanged="MixChanged" PreviewMouseUp="SliderCommit" LostMouseCapture="SliderCommit"/>
                                    <Grid Margin="4,0">
                                        <TextBlock Text="Video sound" Style="{StaticResource Label}" FontSize="10.5" HorizontalAlignment="Left"/>
                                        <TextBlock Text="Music" Style="{StaticResource Label}" FontSize="10.5" HorizontalAlignment="Right"/>
                                    </Grid>
                                </StackPanel>
                                <StackPanel Margin="4,0,0,0">
                                    <v:RibbonButton Glyph="&#xE714;" Label="Emphasize video" Tag="mix_video" Click="Cmd"/>
                                    <v:RibbonButton Glyph="&#xE8D6;" Label="Emphasize music" Tag="mix_music" Click="Cmd"/>
                                    <v:RibbonButton Glyph="&#xE9E9;" Label="Balanced" Tag="mix_even" Click="Cmd"/>
                                </StackPanel>
                                <v:RibbonButton IsLarge="True" Glyph="&#xE916;" GlyphBrush="{DynamicResource B.GlyphGreen}" Label="Fit to music" Tag="fit_music" Click="Cmd" ToolTip="Change photo and title durations so the movie ends with the music"/>
                            </StackPanel>
                        </HeaderedContentControl>
                        <HeaderedContentControl Header="Aspect ratio" Style="{StaticResource RibbonGroup}">
                            <StackPanel Orientation="Horizontal">
                                <v:RibbonToggle x:Name="Asp169" IsLarge="True" Glyph="&#xE7F4;" Label="Widescreen (16:9)" Tag="16:9" Click="AspectClick"/>
                                <v:RibbonToggle x:Name="Asp43" IsLarge="True" Glyph="&#xE7F8;" Label="Standard (4:3)" Tag="4:3" Click="AspectClick"/>
                                <v:RibbonToggle x:Name="Asp916" IsLarge="True" Glyph="&#xE8EA;" Label="Vertical (9:16)" Tag="9:16" Click="AspectClick"/>
                                <v:RibbonToggle x:Name="Asp11" IsLarge="True" Glyph="&#xE739;" Label="Square (1:1)" Tag="1:1" Click="AspectClick"/>
                                <v:RibbonToggle x:Name="Asp219" IsLarge="True" Glyph="&#xE8B2;" Label="Cinema (21:9)" Tag="21:9" Click="AspectClick"/>
                            </StackPanel>
                        </HeaderedContentControl>
                        <HeaderedContentControl Header="Frame rate and framing" Style="{StaticResource RibbonGroup}">
                            <Grid VerticalAlignment="Center" Width="330">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="24"/>
                                    <RowDefinition Height="24"/>
                                    <RowDefinition Height="24"/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="Frame rate" Style="{StaticResource Label}" Margin="0,0,8,0"/>
                                <ComboBox x:Name="FpsCombo" Grid.Column="1" SelectionChanged="FpsChanged"/>
                                <TextBlock Grid.Row="1" Text="Conversion" Style="{StaticResource Label}" Margin="0,0,8,0" ToolTip="How clips with a different frame rate are converted when you save the movie"/>
                                <ComboBox x:Name="InterpCombo" Grid.Row="1" Grid.Column="1" SelectionChanged="InterpChanged"/>
                                <TextBlock Grid.Row="2" Text="Framing" Style="{StaticResource Label}" Margin="0,0,8,0"/>
                                <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal">
                                    <ComboBox x:Name="FitCombo" Width="180" SelectionChanged="FitChanged"/>
                                    <v:ColorButton x:Name="ProjBgColor" Label="Bars" Margin="6,0,0,0" ToolTip="Color of the bars around videos that don't fill the frame"/>
                                </StackPanel>
                            </Grid>
                        </HeaderedContentControl>
                    </StackPanel>

                    <!-- VIEW -->
                    <StackPanel x:Name="PanelView" Orientation="Horizontal" Visibility="Collapsed">
                        <HeaderedContentControl Header="Storyboard zoom" Style="{StaticResource RibbonGroup}">
                            <StackPanel Orientation="Horizontal">
                                <v:RibbonButton IsLarge="True" Glyph="&#xE8A3;" Label="Zoom in" Tag="zoomin" Click="Cmd"/>
                                <v:RibbonButton IsLarge="True" Glyph="&#xE71F;" Label="Zoom out" Tag="zoomout" Click="Cmd"/>
                                <v:RibbonButton IsLarge="True" Glyph="&#xE72C;" Label="Reset" Tag="zoomreset" Click="Cmd"/>
                            </StackPanel>
                        </HeaderedContentControl>
                        <HeaderedContentControl Header="Thumbnail size" Style="{StaticResource RibbonGroup}">
                            <StackPanel VerticalAlignment="Center">
                                <v:RibbonToggle x:Name="ThumbS" Glyph="&#xE80A;" Label="Small" Tag="48" Click="ThumbSizeClick"/>
                                <v:RibbonToggle x:Name="ThumbM" Glyph="&#xE80A;" Label="Medium" Tag="64" Click="ThumbSizeClick"/>
                                <v:RibbonToggle x:Name="ThumbL" Glyph="&#xE80A;" Label="Large" Tag="88" Click="ThumbSizeClick"/>
                            </StackPanel>
                        </HeaderedContentControl>
                        <HeaderedContentControl Header="Preview" Style="{StaticResource RibbonGroup}">
                            <StackPanel Orientation="Horizontal">
                                <Grid VerticalAlignment="Center" Width="230">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="26"/>
                                        <RowDefinition Height="26"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="Quality" Style="{StaticResource Label}" Margin="0,0,8,0"/>
                                    <ComboBox x:Name="PreviewQualityCombo" Grid.Column="1" SelectionChanged="PreviewQualityChanged"/>
                                    <TextBlock Grid.Row="1" Text="Time display" Style="{StaticResource Label}" Margin="0,0,8,0"/>
                                    <ComboBox x:Name="TimecodeCombo" Grid.Row="1" Grid.Column="1" SelectionChanged="TimecodeChanged"/>
                                </Grid>
                                <v:RibbonButton IsLarge="True" Glyph="&#xE740;" Label="Full screen" Tag="fullscreen" Click="Cmd" ToolTip="Full-screen preview (F11)"/>
                            </StackPanel>
                        </HeaderedContentControl>
                        <HeaderedContentControl Header="Appearance" Style="{StaticResource RibbonGroup}">
                            <StackPanel Orientation="Horizontal">
                                <v:RibbonToggle x:Name="ThemeLightBtn" IsLarge="True" Glyph="&#xE706;" Label="Morning" Tag="light" Click="ThemeClick" ToolTip="Light theme"/>
                                <v:RibbonToggle x:Name="ThemeEveningBtn" IsLarge="True" Glyph="&#xE708;" Label="Evening" Tag="evening" Click="ThemeClick" ToolTip="Dusky purple theme"/>
                                <v:RibbonToggle x:Name="ThemeDarkBtn" IsLarge="True" Glyph="&#xE734;" Label="Midnight" Tag="dark" Click="ThemeClick" ToolTip="Black cinema theme"/>
                            </StackPanel>
                        </HeaderedContentControl>
                    </StackPanel>

                    <!-- VIDEO TOOLS: EDIT -->
                    <StackPanel x:Name="PanelVideo" Orientation="Horizontal" Visibility="Collapsed">
                        <HeaderedContentControl x:Name="GrpVideoAudio" Header="Audio" Style="{StaticResource RibbonGroup}">
                            <Grid VerticalAlignment="Center" Width="240">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition Height="24"/><RowDefinition Height="24"/><RowDefinition Height="24"/></Grid.RowDefinitions>
                                <TextBlock Text="Volume" Style="{StaticResource Label}" Margin="0,0,8,0"/>
                                <Slider x:Name="ClipVolSlider" Grid.Column="1" Minimum="0" Maximum="2" ValueChanged="ClipVolChanged" PreviewMouseUp="SliderCommit" LostMouseCapture="SliderCommit" ToolTip="Video volume (0–200%)"/>
                                <TextBlock Grid.Row="1" Text="Fade in/out" Style="{StaticResource Label}" Margin="0,0,8,0"/>
                                <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal">
                                    <ComboBox x:Name="ClipFadeIn" Width="78" SelectionChanged="ClipFadeChanged"/>
                                    <ComboBox x:Name="ClipFadeOut" Width="78" Margin="4,0,0,0" SelectionChanged="ClipFadeChanged"/>
                                </StackPanel>
                                <TextBlock Grid.Row="2" Text="Effect" Style="{StaticResource Label}" Margin="0,0,8,0"/>
                                <ComboBox x:Name="ClipAudioFx" Grid.Row="2" Grid.Column="1" SelectionChanged="ClipAudioFxChanged" ToolTip="Voice and sound effects. 'Match visual effect' picks the audio that goes with the clip's visual effect."/>
                            </Grid>
                        </HeaderedContentControl>
                        <HeaderedContentControl Header="Speed and duration" Style="{StaticResource RibbonGroup}">
                            <Grid VerticalAlignment="Center" Width="170">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="24"/>
                                    <RowDefinition Height="24"/>
                                    <RowDefinition Height="24"/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="Speed" Style="{StaticResource Label}" Margin="0,0,8,0"/>
                                <ComboBox x:Name="SpeedCombo" Grid.Column="1" SelectionChanged="SpeedChanged"/>
                                <TextBlock Grid.Row="1" Text="Duration" Style="{StaticResource Label}" Margin="0,0,8,0"/>
                                <ComboBox x:Name="DurationCombo" Grid.Row="1" Grid.Column="1" IsEditable="True" SelectionChanged="DurationChanged" LostFocus="DurationCommit" KeyDown="ComboEnter" ToolTip="Duration of photos and titles, in seconds"/>
                                <v:RibbonToggle x:Name="ReverseToggle" Grid.Row="2" Grid.ColumnSpan="2" Glyph="&#xE72B;" Label="Reverse (play backwards)" Click="ReverseClick"/>
                            </Grid>
                        </HeaderedContentControl>
                        <HeaderedContentControl Header="Trim" Style="{StaticResource RibbonGroup}">
                            <StackPanel Orientation="Horizontal">
                                <v:RibbonButton IsLarge="True" GlyphPath="M1,3.5 L6,3.5 L6,12.5 L1,12.5 Z M10,3.5 L15,3.5 L15,12.5 L10,12.5 Z M8,1 L8,15" GlyphBrush="{DynamicResource B.GlyphOrange}" Label="Split" Tag="split" Click="Cmd" ToolTip="Split the clip at the playhead (M)"/>
                                <StackPanel VerticalAlignment="Center" Margin="2,0">
                                    <v:RibbonButton Glyph="&#xE892;" Label="Set start point" Tag="setstart" Click="Cmd" ToolTip="Trim the beginning to the playhead (I)"/>
                                    <v:RibbonButton Glyph="&#xE893;" Label="Set end point" Tag="setend" Click="Cmd" ToolTip="Trim the end to the playhead (O)"/>
                                </StackPanel>
                                <Grid VerticalAlignment="Center" Width="150" Margin="4,0,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="26"/>
                                        <RowDefinition Height="26"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="Start point" Style="{StaticResource Label}" Margin="0,0,8,0"/>
                                    <TextBox x:Name="TrimInBox" Grid.Column="1" Height="22" VerticalContentAlignment="Center" LostFocus="TrimBoxCommit" KeyDown="BoxEnter" ToolTip="Seconds into the source file"/>
                                    <TextBlock Grid.Row="1" Text="End point" Style="{StaticResource Label}" Margin="0,0,8,0"/>
                                    <TextBox x:Name="TrimOutBox" Grid.Row="1" Grid.Column="1" Height="22" VerticalContentAlignment="Center" LostFocus="TrimBoxCommit" KeyDown="BoxEnter"/>
                                </Grid>
                            </StackPanel>
                        </HeaderedContentControl>
                        <HeaderedContentControl x:Name="GrpTitleBg" Header="Title" Style="{StaticResource RibbonGroup}">
                            <StackPanel VerticalAlignment="Center">
                                <v:ColorButton x:Name="TitleBgColor" Label="Background color"/>
                                <v:RibbonButton Glyph="&#xE8D2;" Label="Edit text" Tag="edittext" Click="Cmd"/>
                            </StackPanel>
                        </HeaderedContentControl>
                    </StackPanel>

                    <!-- MUSIC TOOLS: OPTIONS -->
                    <StackPanel x:Name="PanelMusic" Orientation="Horizontal" Visibility="Collapsed">
                        <HeaderedContentControl Header="Audio" Style="{StaticResource RibbonGroup}">
                            <Grid VerticalAlignment="Center" Width="240">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition Height="24"/><RowDefinition Height="24"/><RowDefinition Height="24"/></Grid.RowDefinitions>
                                <TextBlock Text="Volume" Style="{StaticResource Label}" Margin="0,0,8,0"/>
                                <Slider x:Name="MusicVolSlider" Grid.Column="1" Minimum="0" Maximum="2" ValueChanged="MusicVolChanged" PreviewMouseUp="SliderCommit" LostMouseCapture="SliderCommit"/>
                                <TextBlock Grid.Row="1" Text="Fade in/out" Style="{StaticResource Label}" Margin="0,0,8,0"/>
                                <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal">
                                    <ComboBox x:Name="MusicFadeIn" Width="78" SelectionChanged="MusicFadeChanged"/>
                                    <ComboBox x:Name="MusicFadeOut" Width="78" Margin="4,0,0,0" SelectionChanged="MusicFadeChanged"/>
                                </StackPanel>
                                <TextBlock Grid.Row="2" Text="Effect" Style="{StaticResource Label}" Margin="0,0,8,0"/>
                                <ComboBox x:Name="MusicAudioFx" Grid.Row="2" Grid.Column="1" SelectionChanged="MusicAudioFxChanged"/>
                            </Grid>
                        </HeaderedContentControl>
                        <HeaderedContentControl Header="Editing" Style="{StaticResource RibbonGroup}">
                            <StackPanel Orientation="Horizontal">
                                <v:RibbonButton IsLarge="True" GlyphPath="M1,3.5 L6,3.5 L6,12.5 L1,12.5 Z M10,3.5 L15,3.5 L15,12.5 L10,12.5 Z M8,1 L8,15" GlyphBrush="{DynamicResource B.GlyphOrange}" Label="Split" Tag="m_split" Click="Cmd"/>
                                <StackPanel VerticalAlignment="Center">
                                    <v:RibbonButton Glyph="&#xE916;" Label="Start at playhead" Tag="m_settime" Click="Cmd"/>
                                    <v:RibbonButton Glyph="&#xE892;" Label="Set start point" Tag="m_setstart" Click="Cmd"/>
                                    <v:RibbonButton Glyph="&#xE893;" Label="Set end point" Tag="m_setend" Click="Cmd"/>
                                </StackPanel>
                                <Grid VerticalAlignment="Center" Width="150" Margin="4,0,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="24"/>
                                        <RowDefinition Height="24"/>
                                        <RowDefinition Height="24"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="Start time" Style="{StaticResource Label}" Margin="0,0,8,0"/>
                                    <TextBox x:Name="MusicStartBox" Grid.Column="1" Height="21" LostFocus="MusicBoxCommit" KeyDown="BoxEnter"/>
                                    <TextBlock Grid.Row="1" Text="Start point" Style="{StaticResource Label}" Margin="0,0,8,0"/>
                                    <TextBox x:Name="MusicInBox" Grid.Row="1" Grid.Column="1" Height="21" LostFocus="MusicBoxCommit" KeyDown="BoxEnter"/>
                                    <TextBlock Grid.Row="2" Text="End point" Style="{StaticResource Label}" Margin="0,0,8,0"/>
                                    <TextBox x:Name="MusicOutBox" Grid.Row="2" Grid.Column="1" Height="21" LostFocus="MusicBoxCommit" KeyDown="BoxEnter"/>
                                </Grid>
                                <v:RibbonButton IsLarge="True" Glyph="&#xE74D;" GlyphBrush="{DynamicResource B.GlyphRed}" Label="Remove" Tag="remove" Click="Cmd"/>
                            </StackPanel>
                        </HeaderedContentControl>
                    </StackPanel>

                    <!-- TEXT TOOLS: FORMAT -->
                    <StackPanel x:Name="PanelText" Orientation="Horizontal" Visibility="Collapsed">
                        <HeaderedContentControl Header="Text" Style="{StaticResource RibbonGroup}">
                            <TextBox x:Name="TextEditBox" Width="160" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" TextChanged="TextEditChanged" LostFocus="TextEditCommit" VerticalAlignment="Stretch" Margin="0,2"/>
                        </HeaderedContentControl>
                        <HeaderedContentControl Header="Font" Style="{StaticResource RibbonGroup}">
                            <StackPanel VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                    <ComboBox x:Name="FontCombo" Width="150" SelectionChanged="FontChanged"/>
                                    <ComboBox x:Name="FontSizeCombo" Width="56" Margin="4,0,0,0" IsEditable="True" SelectionChanged="FontSizeChanged" LostFocus="FontSizeCommit" KeyDown="ComboEnter"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                    <v:RibbonToggle x:Name="BoldBtn" Glyph="&#xE8DD;" Click="BoldClick" ToolTip="Bold"/>
                                    <v:RibbonToggle x:Name="ItalicBtn" Glyph="&#xE8DB;" Click="ItalicClick" ToolTip="Italic"/>
                                    <v:ColorButton x:Name="TextColorBtn" Label="Color" Margin="4,1,1,1"/>
                                    <v:ColorButton x:Name="OutlineColorBtn" Label="Outline" Margin="1"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Outline size" Style="{StaticResource Label}" Margin="2,0,6,0"/>
                                    <ComboBox x:Name="OutlineCombo" Width="90" SelectionChanged="OutlineChanged"/>
                                    <CheckBox x:Name="ShadowCheck" Content="Shadow" Margin="8,0,0,0" VerticalAlignment="Center" Click="ShadowClick"/>
                                </StackPanel>
                            </StackPanel>
                        </HeaderedContentControl>
                        <HeaderedContentControl Header="Paragraph" Style="{StaticResource RibbonGroup}">
                            <StackPanel VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <v:RibbonToggle x:Name="AlignL" Glyph="&#xE8E4;" Tag="Left" Click="AlignClick" ToolTip="Align left"/>
                                    <v:RibbonToggle x:Name="AlignC" Glyph="&#xE8E3;" Tag="Center" Click="AlignClick" ToolTip="Center"/>
                                    <v:RibbonToggle x:Name="AlignR" Glyph="&#xE8E2;" Tag="Right" Click="AlignClick" ToolTip="Align right"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <v:RibbonToggle x:Name="VTop" Glyph="&#xE74A;" Tag="Top" Click="VAlignClick" ToolTip="Top of the frame"/>
                                    <v:RibbonToggle x:Name="VMid" Glyph="&#xE7AC;" Tag="Middle" Click="VAlignClick" ToolTip="Middle of the frame"/>
                                    <v:RibbonToggle x:Name="VBot" Glyph="&#xE74B;" Tag="Bottom" Click="VAlignClick" ToolTip="Bottom of the frame"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Opacity" Style="{StaticResource Label}" Margin="2,0,6,0"/>
                                    <Slider x:Name="TextOpacitySlider" Width="70" Minimum="0.1" Maximum="1" ValueChanged="TextOpacityChanged" PreviewMouseUp="SliderCommit" LostMouseCapture="SliderCommit"/>
                                </StackPanel>
                            </StackPanel>
                        </HeaderedContentControl>
                        <HeaderedContentControl x:Name="GrpTextTiming" Header="Adjust" Style="{StaticResource RibbonGroup}">
                            <StackPanel VerticalAlignment="Center">
                                <v:ColorButton x:Name="TextBgColor" Label="Background"/>
                                <Grid Width="150">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="24"/>
                                        <RowDefinition Height="24"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="Start time" Style="{StaticResource Label}" Margin="0,0,8,0"/>
                                    <TextBox x:Name="TextStartBox" Grid.Column="1" Height="21" LostFocus="TextTimingCommit" KeyDown="BoxEnter"/>
                                    <TextBlock Grid.Row="1" Text="Text duration" Style="{StaticResource Label}" Margin="0,0,8,0"/>
                                    <TextBox x:Name="TextDurBox" Grid.Row="1" Grid.Column="1" Height="21" LostFocus="TextTimingCommit" KeyDown="BoxEnter"/>
                                </Grid>
                            </StackPanel>
                        </HeaderedContentControl>
                        <HeaderedContentControl Header="Styles" Style="{StaticResource RibbonGroup}">
                            <v:Gallery x:Name="TitleStyleGallery" Width="260" Height="74" ItemWidth="72"/>
                        </HeaderedContentControl>
                        <HeaderedContentControl Header="Extras" Style="{StaticResource RibbonGroup}">
                            <StackPanel VerticalAlignment="Center" Width="170">
                                <StackPanel Orientation="Horizontal">
                                    <CheckBox x:Name="GlowCheck" Content="Glow" VerticalAlignment="Center" Margin="2,0,4,0" Click="GlowClick"/>
                                    <v:ColorButton x:Name="GlowColorBtn" Label="Glow color"/>
                                </StackPanel>
                                <ComboBox x:Name="PlateCombo" Margin="0,3" SelectionChanged="PlateChanged" ToolTip="A box or bar behind the text, like a lower third"/>
                                <CheckBox x:Name="BorderCheck" Content="Frame border (titles)" Margin="2,2,0,0" Click="BorderClick"/>
                            </StackPanel>
                        </HeaderedContentControl>
                        <HeaderedContentControl Header="Effects" Style="{StaticResource RibbonGroup}">
                            <v:Gallery x:Name="TextFxGallery" Width="230" Height="74" ItemWidth="66"/>
                        </HeaderedContentControl>
                    </StackPanel>
                </Grid>
                </ScrollViewer>
            </Border>

            <!-- ============ Preview + storyboard ============ -->
            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="320"/>
                    <ColumnDefinition Width="6"/>
                    <ColumnDefinition Width="1.25*" MinWidth="320"/>
                </Grid.ColumnDefinitions>

                <Grid x:Name="PreviewColumn" Background="{DynamicResource B.Panel}" SizeChanged="PreviewColumnSized">
                    <StackPanel VerticalAlignment="Top" Margin="12,12,12,8">
                        <Border x:Name="PreviewFrameBorder" HorizontalAlignment="Center" Padding="0" CornerRadius="3"
                                Background="{DynamicResource B.PreviewFrame}" BorderThickness="0">
                            <Border x:Name="PreviewHost" Background="{DynamicResource B.PreviewBg}" CornerRadius="2" MouseLeftButtonDown="PreviewClick" Width="480" Height="270">
                                <Image x:Name="PreviewImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                            </Border>
                        </Border>
                        <Thumb x:Name="PreviewGrip" Height="9" Cursor="SizeNS" DragDelta="PreviewGripDrag" ToolTip="Drag to resize the preview">
                            <Thumb.Template>
                                <ControlTemplate TargetType="Thumb">
                                    <Grid Background="Transparent">
                                        <Border Width="40" Height="3" CornerRadius="1.5" Background="{DynamicResource B.Thumb}" VerticalAlignment="Center"/>
                                    </Grid>
                                </ControlTemplate>
                            </Thumb.Template>
                        </Thumb>
                        <Slider x:Name="SeekSlider" Minimum="0" Maximum="1" ValueChanged="SeekSliderChanged" Margin="0,0,0,2"/>
                        <Grid>
                            <TextBlock x:Name="TimeText" Text="00:00.00 / 00:00.00" VerticalAlignment="Center" FontFamily="Consolas, Segoe UI" FontSize="13" Foreground="{DynamicResource B.Timecode}"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button Style="{StaticResource TransportButton}" Content="&#xE892;" Tag="prevframe" Click="Cmd" ToolTip="Previous frame (Left arrow)"/>
                                <Button x:Name="PlayButton" Style="{StaticResource TransportButton}" Content="&#xE768;" FontSize="20" Width="44" Tag="play" Click="Cmd" ToolTip="Play/Pause (Space)"/>
                                <Button Style="{StaticResource TransportButton}" Content="&#xE893;" Tag="nextframe" Click="Cmd" ToolTip="Next frame (Right arrow)"/>
                            </StackPanel>
                            <Button Style="{StaticResource TransportButton}" Content="&#xE740;" HorizontalAlignment="Right" Tag="fullscreen" Click="Cmd" ToolTip="Full screen (F11)"/>
                        </Grid>
                        <Border Margin="0,12,0,0" Padding="10,8" CornerRadius="4" Background="{DynamicResource B.Ribbon}" BorderBrush="{DynamicResource B.Border}" BorderThickness="1">
                            <TextBlock x:Name="InfoText" TextWrapping="Wrap" FontSize="11.5" Foreground="{DynamicResource B.Dim}" LineHeight="17"/>
                        </Border>
                    </StackPanel>
                </Grid>

                <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Background="{DynamicResource B.Border}" ResizeBehavior="PreviousAndNext"/>

                <ScrollViewer x:Name="BoardScroll" Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Background="{DynamicResource B.Storyboard}">
                    <v:StoryboardView x:Name="Board"/>
                </ScrollViewer>
            </Grid>

            <!-- ============ Status bar ============ -->
            <Grid Grid.Row="4" Background="{DynamicResource B.Status}">
                <TextBlock x:Name="StatusText" Margin="10,0" VerticalAlignment="Center" Foreground="{DynamicResource B.Dim}" FontSize="11.5"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,10,0">
                    <TextBlock x:Name="ResText" VerticalAlignment="Center" Foreground="{DynamicResource B.Dim}" FontSize="11.5" Margin="0,0,16,0"/>
                    <Button Style="{StaticResource QatButton}" Content="&#xE71F;" FontSize="11" Tag="zoomout" Click="Cmd" ToolTip="Zoom out"/>
                    <Slider x:Name="ZoomSlider" Width="110" Minimum="0" Maximum="1" VerticalAlignment="Center" ValueChanged="ZoomSliderChanged"/>
                    <Button Style="{StaticResource QatButton}" Content="&#xE8A3;" FontSize="11" Tag="zoomin" Click="Cmd" ToolTip="Zoom in"/>
                </StackPanel>
            </Grid>

            <!-- ============ File menu ============ -->
            <Popup x:Name="FileMenu" PlacementTarget="{Binding ElementName=FileTabButton}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True">
                <Border Background="{DynamicResource B.Menu}" BorderBrush="{DynamicResource B.Border}" BorderThickness="1" CornerRadius="0,4,4,4" Padding="6" Width="560">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="210"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <Button Style="{StaticResource FileMenuButton}" Tag="newproj" Click="Cmd"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8A5;" FontFamily="{StaticResource IconFont}" FontSize="16" Margin="0,0,12,0" Foreground="{DynamicResource B.GlyphBlue}"/><TextBlock Text="New project"/></StackPanel></Button>
                            <Button Style="{StaticResource FileMenuButton}" Tag="open" Click="Cmd"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE838;" FontFamily="{StaticResource IconFont}" FontSize="16" Margin="0,0,12,0" Foreground="{DynamicResource B.GlyphOrange}"/><TextBlock Text="Open project…"/></StackPanel></Button>
                            <Button Style="{StaticResource FileMenuButton}" Tag="save" Click="Cmd"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE74E;" FontFamily="{StaticResource IconFont}" FontSize="16" Margin="0,0,12,0"/><TextBlock Text="Save project"/></StackPanel></Button>
                            <Button Style="{StaticResource FileMenuButton}" Tag="saveas" Click="Cmd"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE792;" FontFamily="{StaticResource IconFont}" FontSize="16" Margin="0,0,12,0"/><TextBlock Text="Save project as…"/></StackPanel></Button>
                            <Separator/>
                            <Button Style="{StaticResource FileMenuButton}" Tag="savemovie" Click="Cmd"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE714;" FontFamily="{StaticResource IconFont}" FontSize="16" Margin="0,0,12,0" Foreground="{DynamicResource B.GlyphBlue}"/><TextBlock Text="Export movie…"/></StackPanel></Button>
                            <Button Style="{StaticResource FileMenuButton}" Tag="exportdefaults" Click="Cmd"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE713;" FontFamily="{StaticResource IconFont}" FontSize="16" Margin="0,0,12,0"/><TextBlock Text="Default export settings…"/></StackPanel></Button>
                            <Button Style="{StaticResource FileMenuButton}" Tag="snapshot" Click="Cmd"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE722;" FontFamily="{StaticResource IconFont}" FontSize="16" Margin="0,0,12,0"/><TextBlock Text="Save current frame…"/></StackPanel></Button>
                            <Separator/>
                            <Button Style="{StaticResource FileMenuButton}" Tag="ffmpeg" Click="Cmd"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE713;" FontFamily="{StaticResource IconFont}" FontSize="16" Margin="0,0,12,0"/><TextBlock Text="FFmpeg location…"/></StackPanel></Button>
                            <Button Style="{StaticResource FileMenuButton}" Tag="whatsnew" Click="Cmd"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE789;" FontFamily="{StaticResource IconFont}" FontSize="16" Margin="0,0,12,0" Foreground="{DynamicResource B.Accent}"/><TextBlock Text="What's new"/></StackPanel></Button>
                            <Button Style="{StaticResource FileMenuButton}" Tag="about" Click="Cmd"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE946;" FontFamily="{StaticResource IconFont}" FontSize="16" Margin="0,0,12,0"/><TextBlock Text="About"/></StackPanel></Button>
                            <Button Style="{StaticResource FileMenuButton}" Tag="exit" Click="Cmd"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE7E8;" FontFamily="{StaticResource IconFont}" FontSize="16" Margin="0,0,12,0" Foreground="{DynamicResource B.GlyphRed}"/><TextBlock Text="Exit"/></StackPanel></Button>
                            <StackPanel Orientation="Horizontal" Margin="8,8,0,0">
                            <Button Style="{StaticResource QatButton}" Width="34" Height="24" Click="RainbowClick" ToolTip="A little thank-you">
                                <Canvas Width="22" Height="12">
                                    <Path Data="M1,12 A10,10 0 0 1 21,12" Stroke="#E53935" StrokeThickness="1.7"/>
                                    <Path Data="M2.7,12 A8.3,8.3 0 0 1 19.3,12" Stroke="#FB8C00" StrokeThickness="1.7"/>
                                    <Path Data="M4.4,12 A6.6,6.6 0 0 1 17.6,12" Stroke="#FDD835" StrokeThickness="1.7"/>
                                    <Path Data="M6.1,12 A4.9,4.9 0 0 1 15.9,12" Stroke="#43A047" StrokeThickness="1.7"/>
                                    <Path Data="M7.8,12 A3.2,3.2 0 0 1 14.2,12" Stroke="#1E88E5" StrokeThickness="1.7"/>
                                    <Path Data="M9.5,12 A1.5,1.5 0 0 1 12.5,12" Stroke="#8E24AA" StrokeThickness="1.7"/>
                                </Canvas>
                            </Button>
                            <Button Style="{StaticResource QatButton}" Width="30" Height="24" Margin="4,0,0,0" Click="LabsClick" ToolTip="Labs: experimental extras">
                                <Image Source="{DynamicResource I.Flask}" Width="18" Height="18" RenderOptions.BitmapScalingMode="HighQuality"/>
                            </Button>
                            <Button Style="{StaticResource QatButton}" Width="30" Height="24" Margin="4,0,0,0" Content="&#xE897;" Tag="about" Click="Cmd" ToolTip="About and keyboard shortcuts"/>
                            </StackPanel>
                        </StackPanel>
                        <Border Grid.Column="1" BorderBrush="{DynamicResource B.Border}" BorderThickness="1,0,0,0" Padding="12,4,4,4" Margin="6,0,0,0">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" Text="Recent projects" FontWeight="SemiBold" Margin="0,4,0,8"/>
                                <StackPanel x:Name="RecentList"/>
                            </DockPanel>
                        </Border>
                    </Grid>
                </Border>
            </Popup>
        </Grid>
    </Border>
</Window>
